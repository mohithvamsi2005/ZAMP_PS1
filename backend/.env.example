# Database
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# Environment guard — "production" | "development"
ENVIRONMENT=development

# LLM Provider Configuration — supported: openrouter, llamacpp
LLM_PROVIDER=openrouter

# OpenRouter settings
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local llama.cpp server (Ollama-compatible endpoint)
# LLM_PROVIDER=llamacpp
# LLM_BASE_URL=http://LLAMA_SERVER_IP:11434
# LLM_API_KEY=local-none
# LLM_MODEL=qwen2.5:1.5b

# LLM runtime settings
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# ── Access control (Phase 9) ───────────────────────────────────────────
# When AUTH_PASSWORD is unset, auth is disabled for local dev convenience.
# In ANY shared environment set these. See DEPLOYMENT.md.
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_SECURE_COOKIE=false
CORS_ORIGINS=http://localhost:5173
AUTO_SEED_ON_EMPTY=false

# ── Write-side access control (optional tripwire) ─────────────────────
WRITE_TOKEN=
DIAGNOSTIC_RATE_PER_MINUTE=10
UPLOAD_RATE_PER_MINUTE=30
